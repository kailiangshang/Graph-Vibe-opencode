#!/usr/bin/env bash
set -euo pipefail

# Graph Vibe OpenCode launcher
# Usage:
#   ./scripts/graph-vibe serve          # start server with graph mode (port 4096)
#   ./scripts/graph-vibe serve --port 4444
#   ./scripts/graph-vibe dev            # start TUI with graph mode
#   ./scripts/graph-vibe debug skill    # list discovered skills

export OPENCODE_ENABLE_GRAPH_MODE=1
export OPENCODE_DISABLE_CHANNEL_DB="${OPENCODE_DISABLE_CHANNEL_DB:-1}"

SCRIPT_PATH="${BASH_SOURCE[0]}"
while [ -L "$SCRIPT_PATH" ]; do
  SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
  SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
  if [[ "$SCRIPT_PATH" != /* ]]; then
    SCRIPT_PATH="$SCRIPT_DIR/$SCRIPT_PATH"
  fi
done
REPO_ROOT="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
PROJECT_DIR="$PWD"

cd "$REPO_ROOT/packages/opencode"

if [ "$#" -eq 0 ] || [[ "$1" == -* ]]; then
  set -- "$PROJECT_DIR" "$@"
fi

exec bun run --conditions=browser ./src/index.ts "$@"
